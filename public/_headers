# Cloudflare Workers static-assets headers.
# Browsers must always check for a new service worker, or updates get stuck.
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/manifest.webmanifest
  Cache-Control: no-cache

# The lab's code chunks are named by their content: they never change, so browsers keep them.
/lab/chunks/*
  Cache-Control: public, max-age=31536000, immutable
