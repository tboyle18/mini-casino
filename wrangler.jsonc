{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "mini-casino",
  "compatibility_date": "2026-11-01",
  // Static site only: no Worker script, Cloudflare serves the files in ./dist.
  "assets": {
    "directory": "./dist"
  },
  // Runs before `wrangler deploy` and `wrangler dev`, locally and in Workers Builds.
  "build": {
    "command": "node scripts/build.mjs"
  }
}
