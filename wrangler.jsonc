{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "mini-casino",
  "compatibility_date": "2026-11-01",
  // API routes (sign-in proxy and cloud saves). Everything else is the static site.
  "main": "src/worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Each multiplayer room is a Durable Object (SQLite storage, available on the free plan)
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "TableRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TableRoom"] }],
  "vars": {
    // Neon Auth for the mini-casino Neon project (main branch). Public, not a secret.
    "NEON_AUTH_BASE_URL": "https://ep-long-pine-bdjdpkhe.neonauth.c-8.us-east-2.aws.neon.tech/neondb/auth",
    // Rewarded ads (src/ads.js): Google H5 Games Ads with our AdSense publisher id (public).
    // ADS_TEST "1" asks Google for test ads; set it to "0" once H5 Games Ads is approved.
    "ADS_PROVIDER": "h5",
    "ADS_CLIENT": "ca-pub-8224523419022796",
    "ADS_TEST": "1"
  },
  // DATABASE_URL is a secret: `npx wrangler secret put DATABASE_URL` (production)
  // or a line in .dev.vars (local, gitignored).
  // Runs before `wrangler deploy` and `wrangler dev`, locally and in Workers Builds.
  "build": {
    "command": "node scripts/build.mjs"
  }
}
